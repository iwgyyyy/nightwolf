{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@/engine/*": ["../shared/engine/*"],
      "@/types": ["../shared/types"],
      "@/types/*": ["../shared/types/*"],
      "@/protocol": ["../shared/protocol"]
    }
  },
  "include": ["src", "../shared"]
}
