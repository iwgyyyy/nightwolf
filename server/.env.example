# 复制为 .env（已在 .gitignore 中）。线上部署时配到容器环境变量里。
#
# 这是**唯一**存放管理员密码的地方。客户端不再持有任何副本 ——
# 玩家在页面输入账号密码，服务端校验后签发 30 天有效的 HMAC token。

# 创建房间所需的管理员凭证。留空则拒绝一切建房请求。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# token 签名密钥。不配置时从 ADMIN_USERNAME:ADMIN_PASSWORD 派生
# （派生值在重启间保持稳定；改密码会让已签发的 token 全部失效）。
# 想让 token 独立于密码轮换，就显式配一个随机串：
#   openssl rand -base64 32
# TOKEN_SECRET=

# 监听端口
# PORT=9000
