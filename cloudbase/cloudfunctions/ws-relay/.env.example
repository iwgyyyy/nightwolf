# 复制此文件为 .env 并填入真实值（.env 已在 .gitignore 中，不会提交）
# 本地开发：`bun run dev` 或 `npm run dev` 会通过 Node 原生 --env-file 加载
# 线上部署：把这些变量配到 CloudBase 云函数的"环境变量"面板（index.js 仍然 process.env.* 读）

# 创建房间需要的管理员凭证（客户端也会把这对凭证随 create_room 传过来，后端验证）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 可选：覆盖默认监听端口（默认 9000）
# PORT=9000
