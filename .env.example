# 复制此文件为 .env.local 并填入真实值（.env.local 已在 .gitignore 中）
# 注意：VITE_* 前缀的变量会被打包进客户端 bundle，并非真正的服务端密钥。
# 真正的强校验由 WebSocket 后端完成（CloudBase 云函数环境变量）。

# 管理员创建房间凭证（客户端侧的 UX 门槛 + 传给后端校验）
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=change-me

# WebSocket 服务地址
# - 不设置 → 使用 InMemorySyncService（单浏览器多 tab）
# - 设置 → 使用 WebSocketSyncService（可跨设备）
# 本地开发：先启动 cloudbase/cloudfunctions/ws-relay/ (bun run dev)，再设置
# VITE_WS_URL=ws://localhost:9000
# 生产：VITE_WS_URL=wss://{envId}.api.tcloudbasegateway.com/v1/functions/ws-relay?webfn=true
